# Настройки NetSketch. Скопируйте в .env и заполните.
#
# ВАЖНО: для распознавания рукописного эскиза нужна МОДЕЛЬ ЗРЕНИЯ
# (multimodal). DeepSeek API (deepseek-chat) изображения не принимает —
# используйте OpenAI, Gemini, OpenRouter, Qwen-VL или локальный сервер
# (Ollama / llama.cpp) с vision-моделью.

# ---------------------------------------------------------------- сервер
NS_HOST=127.0.0.1
NS_PORT=8770
NS_OPEN_BROWSER=1

# ---------------------------------------------------------------- модель
# openai | openrouter | gemini | ollama | custom | none
NS_LLM_PROVIDER=openai
NS_LLM_BASE_URL=https://api.openai.com/v1
NS_LLM_MODEL=gpt-4.1
NS_LLM_API_KEY=
NS_LLM_TIMEOUT=180
NS_LLM_MAX_TOKENS=8000

# Локальная vision-модель (пример):
# NS_LLM_PROVIDER=ollama
# NS_LLM_BASE_URL=http://127.0.0.1:11434/v1
# NS_LLM_MODEL=qwen2.5vl:7b

# Внешняя команда распознавания (headless-агент, свой скрипт).
# Получает NS_JOB_DIR и должна положить в него model.json.
# NS_LLM_COMMAND=python C:\path\to\recognizer.py

# ---------------------------------------------------------------- CAD
# Если Open CAD Studio не в PATH:
# NS_OCS_EXE=C:\Program Files\Open CAD Studio\OpenCADStudio.exe
NS_DWG_VERSION=2018
NS_DEFAULT_SHEET=A3

# ---------------------------------------------------------------- данные
# NS_DATA_DIR=D:\netsketch-data
# NS_EXAMPLES_DIR=D:\netsketch-data\examples
